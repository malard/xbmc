  "Player.OnContentGeometryChange": {
    "type": "notification",
    "description": "The picture rectangle in force has changed. Sent when playback starts, when a confirmed change occurs partway through a title, when the picture moves on the screen, and when playback ends - the last carrying the geometry of the GUI, because that is then what is on the screen. Carries the rectangles themselves, so that acting on them needs no further call. The picture moving is a change in its own right: an instruction can move it without changing what the content is, and a display mode switch or a resized window moves it with no instruction at all.",
    "params": [
      {
        "name": "sender",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "data",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "player": {
              "$ref": "#/$defs/Player.Notifications.Player"
            },
            "contentRect": {
              "$ref": "#/$defs/Video.ContentRect"
            },
            "screen": {
              "$ref": "#/$defs/Player.ScreenGeometry",
              "description": "Where Kodi drew that content, absent while nothing is drawn - which is the case for the announcement playback ends with."
            }
          },
          "required": [
            "player",
            "contentRect"
          ]
        }
      }
    ],
    "returns": null
  },
  "Player.OnStop": {
    "type": "notification",
    "description": "Playback of a media item has been stopped. If there is no ID available extra information will be provided.",
    "params": [
      {
        "name": "sender",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "data",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "item": {
              "$ref": "#/$defs/Notifications.Item"
            },
            "end": {
              "type": "boolean",
              "description": "Whether the player has reached the end of the playable item(s) or not"
            }
          },
          "required": [
            "end"
          ]
        }
      }
    ],
    "returns": null
  },
  "Player.OnPlaybackFailed": {
    "type": "notification",
    "description": "Playback of a media item was requested but did not happen. Playback starts asynchronously, so a request that was answered successfully can still fail afterwards.",
    "params": [
      {
        "name": "sender",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      {
        "name": "data",
        "required": true,
        "schema": {
          "type": "object",
          "properties": {
            "item": {
              "$ref": "#/$defs/Notifications.Item"
            },
            "reason": {
              "type": "string",
              "description": "Why the item was not played. \"unplayable\": no player could play it, or the player refused it. \"unresolved\": a plugin did not return a playable item. \"locked\": the master or media source lock refused it. \"error\": the player reported an error after playback had started.",
              "enum": [
                "unplayable",
                "unresolved",
                "locked",
                "error"
              ]
            }
          },
          "required": [
            "reason"
          ]
        }
      }
    ],
    "returns": null
  },
  "Player.OnPropertiesChanged": {
    "type": "notification",
    "description": "Properties of what is seen and heard changed, carrying only what changed. player is present when the change belongs to a playback.",
    "params": [
      {
